# Supabase Configuration
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Configuration (Free tier via Google AI Studio)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_MODEL_INTERPRET=gemini-2.0-flash

# LLM Provider selection ("gemini" | "mock")
LLM_PROVIDER=gemini

# Rate Limiting & Quota Controls (Free Tier Safeguards)
MAX_ANALYSES_PER_USER_PER_DAY=20

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
